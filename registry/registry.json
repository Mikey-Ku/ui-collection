    {
      "id": "indicator-slide",
      "name": "Indicator slide",
      "kind": "motion",
      "group": "Navigation",
      "tags": [
        "segmented",
        "tabs",
        "indicator",
        "slide",
        "travel",
        "switch"
      ],
      "aliases": [
        "toggle group",
        "filter",
        "view switch",
        "underline"
      ],
      "note": "One element travels between options instead of a background jumping between them. Width animates too, so uneven labels still land clean — which is the part most implementations get wrong.",
      "css": [
        "mk-seg",
        "mk-seg__ind",
        "mk-seg__opt"
      ],
      "behavior": "seg",
      "demo": "<div class='mk-seg' data-behavior='seg'><span class='mk-seg__ind'></span><button class='mk-seg__opt' aria-selected='true'>Day</button><button class='mk-seg__opt' aria-selected='false'>Week</button><button class='mk-seg__opt' aria-selected='false'>Month</button></div>",
      "variants": [
        {
          "label": "Two options",
          "demo": "<div class='mk-seg' data-behavior='seg'><span class='mk-seg__ind'></span><button class='mk-seg__opt' aria-selected='true'>Grid</button><button class='mk-seg__opt' aria-selected='false'>List</button></div>"
        },
        {
          "label": "Uneven labels",
          "demo": "<div class='mk-seg' data-behavior='seg'><span class='mk-seg__ind'></span><button class='mk-seg__opt' aria-selected='true'>All</button><button class='mk-seg__opt' aria-selected='false'>In progress</button><button class='mk-seg__opt' aria-selected='false'>Shipped</button></div>"
        }
      ],
      "motion": [
        {
          "label": "Travel",
          "value": "translateX · 0.6s",
          "note": "Position is written as a custom property from the active option's offsetLeft."
        },
        {
          "label": "Width",
          "value": "width · 0.6s",
          "note": "Animated alongside, so uneven labels never cause a snap at the end."
        },
        {
          "label": "Re-measure",
          "value": "ResizeObserver",
          "note": "Widths shift when fonts land or the container resizes; measuring once is not enough."
        }
      ],
      "uses": [
