{
  "name": "mk-ui board",
  "version": "0.4.0",
  "note": "Families group variants of one component. Motion tiles are a single idea each, because an animation is not a variant of anything.",
  "items": [
    {
      "id": "buttons",
      "name": "Buttons",
      "kind": "family",
      "tags": ["button", "action", "primary", "secondary", "ghost", "danger", "hover", "press"],
      "aliases": ["click", "cta", "submit", "save", "cancel", "delete"],
      "note": "Straight off michaelkujr.me: display face at 500, 4px radius, and a 2px lift on hover. A trailing arrow walks forward 3px with it — that pairing is the signature.",
      "css": ["mk-btn", "mk-btn--primary", "mk-btn--secondary", "mk-btn--ghost", "mk-btn--danger"],
      "demo": "<div class='mk-row mk-wrap mk-gap-2' style='justify-content:center'><button class='mk-btn mk-btn--primary'>View projects <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14M12 5l7 7-7 7'/></svg></button><button class='mk-btn mk-btn--secondary'>Resume</button><button class='mk-btn mk-btn--ghost'>Get in touch</button></div>"
    },
    {
      "id": "selection",
      "name": "Selection",
      "kind": "family",
      "tags": ["switch", "toggle", "checkbox", "check", "boolean", "setting"],
      "aliases": ["on off", "enable", "tick", "opt in", "confirm"],
      "note": "Switch for things that apply instantly, checkbox for things you submit. The check strokes itself in rather than popping.",
      "css": ["mk-switch", "mk-switch__track", "mk-tick", "mk-tick__box"],
      "demo": "<div class='mk-stack mk-gap-4'><label class='mk-switch'><input type='checkbox' checked><span class='mk-switch__track'></span>Notifications</label><label class='mk-tick'><input type='checkbox'><span class='mk-tick__box'><svg viewBox='0 0 16 16'><path d='M3.5 8.6 L6.4 11.5 L12.5 4.8'/></svg></span>Reviewed</label></div>"
    },
    {
      "id": "loading",
      "name": "Loading",
      "kind": "family",
      "tags": ["spinner", "skeleton", "shimmer", "dots", "placeholder", "wait"],
      "aliases": ["busy", "pending", "ghost", "stub", "loading state"],
      "note": "Dots for a moment, shimmer for a shape you already know the size of. Both freeze flat under reduced motion.",
      "css": ["mk-spinner", "mk-skeleton"],
      "demo": "<div class='mk-stack mk-gap-5' style='align-items:center;width:200px'><span class='mk-spinner' style='color:var(--mk-accent)'><i></i><i></i><i></i></span><div class='mk-stack mk-gap-2' style='width:100%'><div class='mk-skeleton' style='height:10px;width:54%'></div><div class='mk-skeleton' style='height:10px'></div><div class='mk-skeleton' style='height:10px;width:76%'></div></div></div>"
    },
    {
      "id": "indicator-slide",
      "name": "Indicator slide",
      "kind": "motion",
      "tags": ["segmented", "tabs", "indicator", "slide", "travel", "switch"],
      "aliases": ["toggle group", "filter", "view switch", "underline"],
      "note": "One element travels between options instead of a background jumping. Width animates too, so uneven labels still land clean.",
      "css": ["mk-seg", "mk-seg__ind", "mk-seg__opt"],
      "behavior": "seg",
      "demo": "<div class='mk-seg' data-behavior='seg'><span class='mk-seg__ind'></span><button class='mk-seg__opt' aria-selected='true'>Day</button><button class='mk-seg__opt' aria-selected='false'>Week</button><button class='mk-seg__opt' aria-selected='false'>Month</button></div>"
    },
    {
      "id": "label-swap",
      "name": "Label swap",
      "kind": "motion",
      "tags": ["copy", "clipboard", "swap", "crossfade", "confirm"],
      "aliases": ["duplicate", "copied", "success", "morph"],
      "note": "Both labels sit in one grid cell and crossfade past each other, so the button never changes width mid-swap.",
      "css": ["mk-copy", "mk-copy__swap"],
      "behavior": "copy",
      "demo": "<button class='mk-btn mk-btn--secondary mk-copy' data-behavior='copy'><span class='mk-copy__swap'><span>Copy token</span><span>Copied</span></span></button>"
    },
    {
      "id": "toast-in-out",
      "name": "Toast in / out",
      "kind": "motion",
      "tags": ["toast", "notification", "slide", "scale", "transient", "enter", "exit"],
      "aliases": ["snackbar", "popup", "message", "alert"],
      "note": "Rises and scales in, holds, then falls away. The exit is shorter than the entrance — leaving should feel quicker than arriving.",
      "css": ["mk-toast"],
      "behavior": "toast",
      "demo": "<div class='mk-stack mk-gap-3' style='align-items:center'><button class='mk-btn mk-btn--secondary' data-behavior='toast'>Show toast</button><div data-toast-slot style='min-height:44px;display:grid;place-items:center'></div></div>"
    },
    {
      "id": "meter-fill",
      "name": "Meter fill",
      "kind": "motion",
      "tags": ["progress", "meter", "bar", "grow", "confidence", "score"],
      "aliases": ["percent", "gauge", "loading bar", "level"],
      "note": "Grows to its value rather than appearing at it. Costs one frame and makes the number feel measured instead of asserted.",
      "css": ["mk-meter", "mk-meter__fill"],
      "behavior": "meter",
      "demo": "<div class='mk-stack mk-gap-3' style='width:210px;align-items:center'><div class='mk-meter' style='width:100%'><div class='mk-meter__fill' data-meter style='width:0%'></div></div><button class='mk-btn mk-btn--ghost mk-btn--sm' data-behavior='meter'>Run again</button></div>"
    }
  ]
}
