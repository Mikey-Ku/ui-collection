      ],
      "aliases": [
        "click",
        "cta",
        "submit",
        "save",
        "cancel",
        "delete"
      ],
      "note": "Four weights of one shape. Everything that gives a button its character here is motion, not decoration: it lifts 2px on hover and a trailing arrow walks 3px with it. No glow, no fill flash, no shadow at rest.",
      "css": [
        "mk-btn",
        "mk-btn--primary",
        "mk-btn--secondary",
        "mk-btn--ghost",
        "mk-btn--danger",
        "mk-btn--icon"
      ],
      "sizes": true,
      "sizeDemo": "<button class='mk-btn mk-btn--primary'>Save changes</button>",
      "demo": "<div class='mk-row mk-wrap mk-gap-2' style='justify-content:center'><button class='mk-btn mk-btn--primary'>View projects <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14M12 5l7 7-7 7'/></svg></button><button class='mk-btn mk-btn--secondary'>Resume</button></div>",
      "variants": [
        {
          "label": "Primary",
          "demo": "<button class='mk-btn mk-btn--primary'>Save changes</button>"
        },
        {
          "label": "Secondary",
          "demo": "<button class='mk-btn mk-btn--secondary'>Cancel</button>"
        },
        {
