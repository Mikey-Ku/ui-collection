        {
          "label": "Danger",
          "demo": "<button class='mk-btn mk-btn--danger'>Delete</button>"
        },
        {
          "label": "With arrow",
          "demo": "<button class='mk-btn mk-btn--primary'>View projects <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14M12 5l7 7-7 7'/></svg></button>"
        },
        {
          "label": "Icon only",
          "demo": "<button class='mk-btn mk-btn--secondary mk-btn--icon' aria-label='More'>&hellip;</button>"
        },
        {
          "label": "Disabled",
          "demo": "<button class='mk-btn mk-btn--primary' disabled>Save changes</button>"
        }
      ],
      "motion": [
        {
          "label": "Hover lift",
          "value": "translateY(-2px) · 0.25s",
          "note": "The whole reason it reads as pressable. Nothing else changes."
        },
        {
          "label": "Arrow walk",
          "value": "translateX(3px) · 0.25s",
          "note": "Only the trailing glyph moves. A leading icon stays put."
        },
        {
          "label": "Press",
          "value": "translateY(0) · 0.25s",
          "note": "Returns to the resting plane rather than pushing below it."
        }
      ],
      "uses": [
        {
          "label": "Form footer",
          "note": "Ghost for the way out, primary for the way forward.",
          "demo": "<div class='mk-row mk-gap-2' style='justify-content:flex-end'><button class='mk-btn mk-btn--ghost'>Cancel</button><button class='mk-btn mk-btn--primary'>Save changes</button></div>"
        },
        {
          "label": "Page call to action",
          "note": "The arrow earns its place when the button leads somewhere.",
          "demo": "<div class='mk-row mk-wrap mk-gap-2'><button class='mk-btn mk-btn--primary'>View projects <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14M12 5l7 7-7 7'/></svg></button><button class='mk-btn mk-btn--secondary'>Resume</button></div>"
        },
