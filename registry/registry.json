    {
      "id": "meter-fill",
      "name": "Meter fill",
      "kind": "motion",
      "group": "Feedback",
      "tags": [
        "progress",
        "meter",
        "bar",
        "grow",
        "confidence",
        "score"
      ],
      "aliases": [
        "percent",
        "gauge",
        "loading bar",
        "level"
      ],
      "note": "Grows to its value rather than appearing at it. Costs one frame and makes the number feel measured instead of asserted — which matters a lot when the number is a model's confidence.",
      "css": [
        "mk-meter",
        "mk-meter__fill"
      ],
      "behavior": "meter",
      "demo": "<div class='mk-stack mk-gap-3' style='width:210px;align-items:center'><div class='mk-meter' style='width:100%'><div class='mk-meter__fill' data-meter style='width:0%'></div></div><button class='mk-btn mk-btn--ghost mk-sm' data-behavior='meter'>Run again</button></div>",
      "motion": [
        {
          "label": "Fill",
          "value": "width 0 → value · 0.6s",
          "note": "Two nested requestAnimationFrame calls before setting the width, or the browser collapses both styles into one paint and nothing animates."
        }
      ],
      "uses": [
